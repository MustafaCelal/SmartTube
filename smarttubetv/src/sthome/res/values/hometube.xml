<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- HomeTube: Search and Account live in the sidebar rail (YouTube TV-like) -->
    <bool name="hometube_rail_actions">true</bool>

    <!-- HomeTube: regular (wider) Roboto instead of condensed, closer to the YouTube app -->
    <style name="TextAppearance.Leanback" parent="TextAppearance.LeanbackBase">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- HomeTube: slightly smaller card titles -->
    <dimen name="lb_basic_card_title_text_size">14sp</dimen>

    <!-- HomeTube: no title bar above the rows (Search/Account are in the rail) -->
    <dimen name="lb_browse_rows_margin_top">56dp</dimen>
    <!-- HomeTube: YouTube TV-like focus: bigger zoom -->
    <item name="lb_focus_zoom_factor_small" type="fraction">106%</item>
    <dimen name="hometube_player_dock_gap">8dp</dimen>

    <!-- HomeTube: narrow YouTube TV-like sidebar (icons hug the left edge, smaller expanded menu) -->
    <style name="BrowseHeaderStyle" parent="Widget.Leanback.Headers.VerticalGridView">
        <item name="android:verticalSpacing">@dimen/browse_headers_vertical_spacing</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">40dp</item>
    </style>
    <dimen name="lb_browse_headers_width">270dp</dimen>
    <dimen name="lb_browse_rows_margin_start">270dp</dimen>

    <!-- HomeTube: empty/error screens use the same background as the rail (no two-tone look) -->
    <color name="lb_error_background_color_translucent">#F20F0F0F</color>
    <!-- HomeTube: bigger cards in rows (Home, search), more air between cards -->
    <dimen name="hometube_row_card_width">300dp</dimen>
    <dimen name="grid_item_horizontal_spacing">24dp</dimen>
    <dimen name="grid_item_vertical_spacing">28dp</dimen>
    <!-- HomeTube: row titles brighter and medium weight -->
    <style name="TextAppearance.Leanback.Row.Header" parent="TextAppearance.Leanback.Header">
        <item name="android:textColor">#F1F1F1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
    </style>
    <!-- HomeTube: start screen color (Android 12+) -->
    <item name="app_start_color" type="color">@color/scheme_hometube_background</item>
</resources>
